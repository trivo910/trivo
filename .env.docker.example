APP_NAME=Trivo
APP_ENV=production
APP_KEY=
APP_DEBUG=false
DOMAIN=example.com
APP_URL=https://example.com
CANONICAL_URL=https://example.com

# Must be 8-64 letters, numbers, underscores or hyphens.
ADMIN_PATH=trivo-control
ADMIN_ALLOWED_IPS=
CSP_ENFORCE=false

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=trivo
DB_USERNAME=trivo_app
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=20
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
LOG_CHANNEL=stderr
LOG_LEVEL=warning

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Copy the existing uploads here on the VPS before starting containers.
LEGACY_UPLOADS_PATH=./public/wp-content/uploads
IMAGE_TAG=latest
